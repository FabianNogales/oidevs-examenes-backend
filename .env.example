APP_NAME=EIDA
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=UTC
APP_URL=http://localhost
FRONTEND_URL=http://127.0.0.1:5173
EIDA_INSTITUTIONAL_EMAIL_DOMAINS=

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
APP_MAINTENANCE_STORE=database

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
# Local configuration below. In Render use the secret DB_URL instead;
# its query string must include sslmode=require. See docs/DEPLOY_RENDER.md.
DB_URL=
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=oidevs_examenes
DB_USERNAME=postgres
DB_PASSWORD=

SESSION_DRIVER=file
SESSION_LIFETIME=5
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=false
SESSION_SAME_SITE=lax
SANCTUM_STATEFUL_DOMAINS=127.0.0.1:5173,localhost:5173

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync

CACHE_STORE=file
CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Render overrides (set these in the dashboard, do not copy the local .env):
# APP_ENV=production
# APP_DEBUG=false
# APP_KEY= (secret generated externally; never commit its value)
# APP_URL=https://<service>.onrender.com
# FRONTEND_URL=https://oidevs-examenes-frontend.vercel.app
# SANCTUM_STATEFUL_DOMAINS=oidevs-examenes-frontend.vercel.app
# EIDA_INSTITUTIONAL_EMAIL_DOMAINS=umss.edu.bo,est.umss.edu
# DB_CONNECTION=pgsql
# DB_URL= (secret Neon connection string with sslmode=require)
# SESSION_DRIVER=file
# SESSION_LIFETIME=5
# SESSION_ENCRYPT=false
# SESSION_PATH=/
# SESSION_DOMAIN=null (or omit; never use the Render hostname)
# SESSION_SECURE_COOKIE=true
# SESSION_SAME_SITE=lax
# LOG_CHANNEL=stderr
# LOG_LEVEL=info
# FILESYSTEM_DISK=local
# QUEUE_CONNECTION=sync
# CACHE_STORE=file
# MAIL_MAILER=log (demo only; configure SMTP for real password reset emails)
# PGCHANNELBINDING=require (optional libpq setting; see deployment guide)
