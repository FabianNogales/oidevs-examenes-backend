APP_NAME=EIDA
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=UTC
APP_URL=http://localhost
FRONTEND_URL=http://127.0.0.1:5173
# Extra exact browser origins, comma-separated; no wildcard or literal null.
CORS_ALLOWED_ORIGINS=
# Set only after verifying the deployed ingress; empty trusts no proxy.
# TRUSTED_PROXIES=
EIDA_INSTITUTIONAL_EMAIL_DOMAINS=
# HU44/HU45: authorized external service hosts; optional dot-delimited subdomains.
EIDA_SERVICE_ALLOWED_DOMAINS=umss.edu.bo
EIDA_SERVICE_ALLOW_SUBDOMAINS=true
# Explicit opt-in for EidaFullDemoSeeder, including hosted demo environments.
# Keep false on real production databases; --force does not bypass this guard.
EIDA_ALLOW_DEMO_SEEDING=false

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
APP_MAINTENANCE_STORE=database

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
# Local configuration below. In Render use the secret DB_URL instead;
# its query string must include sslmode=require. See docs/DEPLOY_RENDER.md.
DB_URL=
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=oidevs_examenes
DB_USERNAME=postgres
DB_PASSWORD=
# Local compatibility default. Public PostgreSQL connections must use require
# (or verify-full with the provider CA), including sslmode in DB_URL if present.
DB_SSLMODE=prefer
DB_SSLROOTCERT=

SESSION_DRIVER=file
SESSION_LIFETIME=5
SESSION_ENCRYPT=false
# Turning SESSION_ENCRYPT on changes stored-session format: retire old sessions
# deliberately; keep APP_KEY stable. In production set SESSION_SECURE_COOKIE=true.
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=false
SESSION_SAME_SITE=lax
SANCTUM_STATEFUL_DOMAINS=127.0.0.1:5173,localhost:5173

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync

CACHE_STORE=file
CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
# LOCAL ONLY. Production password recovery returns 503 while this is log/array,
# or a failover/roundrobin includes either. Configure and verify real SMTP/API first.
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# RNF7/RNF10: inactive until OAuth, protected execution branch, Worker/D1
# and the pending migration are reviewed. Never paste real values in this file.
EIDA_BACKUPS_ENABLED=false
# Temporary diagnostic endpoints; keep false outside the investigation.
EIDA_BACKUPS_DIAGNOSTICS_ENABLED=false
EIDA_BACKUPS_EXECUTOR=github
EIDA_BACKUPS_GITHUB_REPOSITORY=
EIDA_BACKUPS_GITHUB_REF=backup-execution
EIDA_BACKUPS_GITHUB_TOKEN=
# Shared only by Laravel and the runner; random secret of at least 32 bytes.
EIDA_BACKUPS_CALLBACK_SECRET=
# Same OAuth application + dedicated account in backend, runner and Worker.
# Scope drive.file; use an app-created/explicitly authorized PRIVATE folder.
EIDA_BACKUPS_DRIVE_CLIENT_ID=
EIDA_BACKUPS_DRIVE_CLIENT_SECRET=
EIDA_BACKUPS_DRIVE_REFRESH_TOKEN=
EIDA_BACKUPS_DRIVE_FOLDER_ID=
# Separate from callback secret. Endpoint must be HTTPS and end in /download.
EIDA_BACKUPS_DOWNLOADS_ENABLED=false
EIDA_BACKUPS_DOWNLOAD_WORKER_URL=
EIDA_BACKUPS_DOWNLOAD_SIGNING_SECRET=
EIDA_BACKUPS_TICKET_ISSUER=
EIDA_BACKUPS_TICKET_KEY_ID=

VITE_APP_NAME="${APP_NAME}"

# QR v3 issuance, sync verification and mobile manifest publication are independent.
EIDA_QR_V3_ENABLED=false
EIDA_QR_V3_KID=
EIDA_QR_V3_ISSUER=
EIDA_QR_V3_AUDIENCE=eida-control-qr
# PEM completos con BEGIN/END y saltos de línea reales. Configurar solo en el entorno de ejecución.
EIDA_QR_V3_PUBLIC_KEY=
EIDA_QR_V3_PRIVATE_KEY=
EIDA_OFFLINE_SYNC_QR_V3_VERIFY=false
MOBILE_OFFLINE_QR_V3_ISSUED=false

# Render overrides (set these in the dashboard, do not copy the local .env):
# APP_ENV=production
# APP_DEBUG=false
# APP_KEY= (secret generated externally; never commit its value)
# APP_URL=https://<service>.onrender.com
# FRONTEND_URL=https://oidevs-examenes-frontend.vercel.app
# SANCTUM_STATEFUL_DOMAINS=oidevs-examenes-frontend.vercel.app
# EIDA_INSTITUTIONAL_EMAIL_DOMAINS=umss.edu.bo,est.umss.edu
# DB_CONNECTION=pgsql
# DB_URL= (secret Neon connection string with sslmode=require)
# SESSION_DRIVER=file
# SESSION_LIFETIME=5
# SESSION_ENCRYPT=false (opt-in after planning retirement of existing sessions)
# SESSION_PATH=/
# SESSION_DOMAIN=null (or omit; never use the Render hostname)
# SESSION_SECURE_COOKIE=true
# SESSION_SAME_SITE=lax
# LOG_CHANNEL=stderr
# LOG_LEVEL=info
# FILESYSTEM_DISK=local
# QUEUE_CONNECTION=sync
# CACHE_STORE=file
# MAIL_MAILER=smtp (only with an authorized, configured and tested mail provider)
# EIDA_MOBILE_TOKEN_TTL_MINUTES=720 (explicit mobile lifetime, max 10080)
# SANCTUM_EXPIRATION is intentionally unused: no global cutoff for explicit mobile TTL.
# PGCHANNELBINDING=require (optional libpq setting; see deployment guide)
