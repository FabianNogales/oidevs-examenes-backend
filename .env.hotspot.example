# ============================================
# DEMOSTRACIÓN EIDA — RED LOCAL SIN INTERNET
# ============================================
# PERFIL PARCIAL: integrar estas líneas en el .env LOCAL existente.
# NO copiar este archivo sobre .env: se deben conservar APP_KEY, DB_USERNAME,
# DB_PASSWORD y los dominios institucionales actuales, sin revelarlos.
# Guía: docs/DEMO_LAN_OFFLINE.md

# CAMBIAR: sustituir IP_LAPTOP por la IPv4 de Windows conectado al hotspot.
# Ejemplo ilustrativo: EIDA_LAN_HOST=192.168.43.100
EIDA_LAN_HOST=IP_LAPTOP
# HTTP: http. Para cámara móvil con certificado confiable: https.
EIDA_LAN_SCHEME=http

# No editar estas derivaciones al cambiar de red: se expanden desde las dos
# variables anteriores al cargar .env (si no hay overrides exportados/cache).
FRONTEND_URL="${EIDA_LAN_SCHEME}://${EIDA_LAN_HOST}:5173"
APP_URL="${FRONTEND_URL}/backend"
SANCTUM_STATEFUL_DOMAINS="${EIDA_LAN_HOST}:5173,localhost:5173,127.0.0.1:5173"

APP_ENV=local
SESSION_DRIVER=file
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=false
SESSION_SAME_SITE=lax
# Para HTTPS local confiable: SESSION_SECURE_COOKIE=true.

# Mantener PostgreSQL en la laptop. Nunca poner aquí la IP del hotspot.
DB_CONNECTION=pgsql
DB_URL=
DB_HOST=127.0.0.1
DB_PORT=5432
# CAMBIAR solo si la BD local existente tiene otro nombre.
DB_DATABASE=oidevs_examenes
# DB_USERNAME y DB_PASSWORD: conservar sus valores locales existentes.

FILESYSTEM_DISK=local
CACHE_STORE=file
QUEUE_CONNECTION=sync
MAIL_MAILER=log
# El correo se registra localmente: no se entrega por SMTP sin Internet.
