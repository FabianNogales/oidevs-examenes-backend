  "info": {
    "_postman_id": "a0f994fb-eb25-4995-8534-d51dfda1f2e2",
    "name": "EIDA - QA Sprint 1 - HU01-HU05",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Artefactos QA RUN-01 derivados de route:list, controladores, Form Requests y contrato CSV. Autenticacion Sanctum mediante cookies. Seleccionar EIDA - QA RUN-01. Ejecutar manualmente por escenario segun README; el orden de carpetas no es un flujo de Collection Runner. Las operaciones de escritura modificaran datos al enviarlas. No se ejecutaron requests durante la preparacion."
  },
  "auth": {
    "type": "noauth"
  },
  "event": [
    {
      "listen": "test",
      "script": {
        "type": "text/javascript",
        "exec": [
          "// Sin requests adicionales: sincroniza el token cuando Laravel renueva la cookie.",
          "const rotatedCookie = pm.response.headers.all().find(h => h.key.toLowerCase() === 'set-cookie' && /^XSRF-TOKEN=/.test(h.value));",
          "if (rotatedCookie) {",
          "  pm.environment.set('xsrf_token', '');",
          "  const encoded = rotatedCookie.value.split(';')[0].slice('XSRF-TOKEN='.length);",
          "  pm.environment.set('xsrf_token', decodeURIComponent(encoded));",
          "}"
        ]
      }
    }
  ],
  "item": [
    {
      "name": "00 - Auth Setup",
      "item": [
        {
          "name": "GET - CSRF Cookie",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json",
                "type": "text"
              },
              {
                "key": "Origin",
                "value": "{{frontend_url}}",
                "type": "text"
              },
              {
                "key": "Referer",
                "value": "{{frontend_url}}/",
                "type": "text"
              }
            ],
            "url": "{{base_url}}/sanctum/csrf-cookie",
            "description": "Ejecutar antes del login y nuevamente despues de logout. Guarda XSRF-TOKEN decodificado en xsrf_token. Mantener habilitado el cookie jar."
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.environment.set('xsrf_token', '');",
                  "const setCookie = pm.response.headers.all().find(h => h.key.toLowerCase() === 'set-cookie' && /^XSRF-TOKEN=/.test(h.value));",
                  "const encodedToken = setCookie ? setCookie.value.split(';')[0].slice('XSRF-TOKEN='.length) : pm.cookies.get('XSRF-TOKEN');",
                  "pm.test('CSRF Cookie responde 204', function () {",
                  "  pm.response.to.have.status(204);",
                  "});",
                  "pm.test('XSRF-TOKEN disponible y decodificable', function () {",
                  "  pm.expect(encodedToken).to.be.a('string').and.not.empty;",
                  "  pm.environment.set('xsrf_token', decodeURIComponent(encodedToken));",
                  "});"
                ]
              }
            }
          ]
        },
